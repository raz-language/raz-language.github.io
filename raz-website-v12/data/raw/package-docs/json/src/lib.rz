namespace json;

public import json::core;
public import json::document;
public import json::pointer;
public import json::writer;

public fn version_major() -> i64 {
    return 0;
}

public fn version_minor() -> i64 {
    return 1;
}

public fn version_patch() -> i64 {
    return 0;
}
